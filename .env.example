# Copy to .env.local for local dev, or set these as real env vars in each
# deployment environment. Never commit an actual .env.local / .env.production
# file — only this template is tracked in git.

# Server-side only. The backend the /api/* and /health proxy (next.config.js)
# forwards to. NOT exposed to the browser. Required in production builds —
# next.config.js throws at boot if this is unset when NODE_ENV=production, to
# avoid silently serving production traffic from a staging backend.
#   Old backend (staging):  https://sigma-api.runasp.net
#   New backend (prod):     https://api.sigma.sa
BACKEND_API_URL=https://sigma-api.runasp.net

# Must stay EMPTY. Axios calls same-origin `/api/*`, proxied server-side by
# BACKEND_API_URL above — this avoids CORS entirely (see next.config.js). If
# this is set to an absolute URL instead, browser requests go cross-origin,
# which breaks the `X-Branch-Id` header (forces a CORS preflight) and
# `withCredentials: true` (invalid combined with a wildcard CORS origin).
NEXT_PUBLIC_API_BASE_URL=

# development | production — gates verbose request/response console logging
# in src/lib/api/client.ts.
NEXT_PUBLIC_ENV=development

# Identifies which backend deployment this build's cached auth state belongs
# to (see src/lib/auth/backendGuard.ts). Branch IDs and tokens are database-
# scoped; bump this value whenever BACKEND_API_URL is repointed at a backend
# with different underlying data (e.g. the runasp.net -> api.sigma.sa
# cutover) so returning users' stale localStorage is purged instead of
# silently reused against the wrong backend.
NEXT_PUBLIC_BACKEND_ID=sigma-api-runasp-net

# Optional. Axios request timeout in ms. Defaults to 30000 (src/config/api.config.ts).
# NEXT_PUBLIC_API_TIMEOUT=30000

# Optional. Overrides the hardcoded R2 CDN base in src/utils/image.ts used to
# resolve relative image paths returned by the API. Leave unset to use the
# current default bucket.
# NEXT_PUBLIC_CDN_BASE_URL=https://pub-f187258d7c85424fa237dc86a126271b.r2.dev
